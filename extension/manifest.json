{
  "manifest_version": 3,
  "name": "Placed",
  "version": "0.2.0",
  "description": "Fills internship application forms from your Placed Answer Vault (never presses Submit) and reads your own LinkedIn profile for your Placed LinkedIn Score.",
  "permissions": [
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3200/*",
    "http://localhost:3000/*",
    "https://placed-lovat.vercel.app/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.lever.co/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.lever.co/*"
      ],
      "js": [
        "config.js",
        "lib/guard.js",
        "lib/fill-plan.js",
        "lib/job-match.js",
        "lib/dom.js",
        "fillers/greenhouse.js",
        "fillers/ashby.js",
        "fillers/lever.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3200/*",
        "http://localhost:3000/*",
        "https://placed-lovat.vercel.app/*"
      ],
      "js": [
        "config.js",
        "placed-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.linkedin.com/in/*"
      ],
      "js": [
        "lib/guard.js",
        "linkedin.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
