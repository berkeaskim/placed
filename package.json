{
  "name": "placed",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first internship co-pilot for UK students: honest CV scoring, tailoring that never fabricates, live jobs and an application tracker.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkeaskim/placed.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/pack-extension.mjs",
    "setup": "tsx scripts/setup.ts",
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "node scripts/pack-extension.mjs",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "schedule:install": "tsx scripts/schedule.ts install",
    "schedule:uninstall": "tsx scripts/schedule.ts uninstall",
    "schedule:status": "tsx scripts/schedule.ts status",
    "snapshot": "tsx --env-file-if-exists=.env.local scripts/snapshot.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/setup.ts --no-ingest",
    "validate-slugs": "tsx scripts/validate-slugs.ts",
    "coverage": "tsx scripts/coverage.ts",
    "e2e": "playwright test",
    "build-playbooks": "tsx scripts/build-playbooks.ts",
    "demo:cv": "node scripts/run-ts.mjs scripts/make-demo-cv.ts",
    "reliability": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/reliability.ts",
    "db:generate": "drizzle-kit generate",
    "recon": "python3 scripts/recon/capture_xhr.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.29.0",
    "@react-pdf/renderer": "^4.9.0",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fflate": "^0.8.3",
    "jiti": "^2.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
