NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MODE=
CRON_SECRET=
NEXT_PUBLIC_DEMO_MODE=0
# The "Try the demo" persona: the LIVE public demo on the production database. Not a test account.
DEMO_EMAIL=
DEMO_PASSWORD=
# Set to 1 for ONE command, only with Berke's OK, to let demo:user / demo:reset / demo:tracker and the demo e2e specs
# write to the live demo account. Never put it in .env.local.
# PLACED_ALLOW_LIVE_DEMO_WRITE=1
# Dedicated Playwright test account (e.g. e2e@placed.example.test). Must not be DEMO_EMAIL; global setup refuses it.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Google OAuth client ID for the read-only Gmail connection (Inbox Agent)
GOOGLE_CLIENT_ID=
# Google OAuth client secret for the same client
GOOGLE_CLIENT_SECRET=
# 32-byte key that encrypts stored Gmail refresh tokens; generate with: openssl rand -base64 32
GMAIL_TOKEN_KEY=
