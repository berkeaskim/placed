# Placed runs with no configuration at all: `npm run setup && npm run dev`.
# Everything below is an OPTIONAL override. To use one, copy this file to .env.local and uncomment the line.
# API keys and the AI provider can also be set in the app under Settings → AI (stored encrypted in ./data).
# A value set here wins over the one saved in Settings.

# Which AI backend to use: anthropic, gemini, ollama or codex (ChatGPT through the Codex CLI). Unset = what you picked in Settings → AI,
# else the first provider that has a key.
# AI_PROVIDER=anthropic

# Claude (https://console.anthropic.com) and Gemini (https://aistudio.google.com/apikey) keys.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Where Ollama listens, if you run local models (default http://127.0.0.1:11434).
# OLLAMA_HOST=http://127.0.0.1:11434

# Path to the Codex CLI, if `codex` isn't on the PATH the server sees (sign in once with `codex login`).
# CODEX_BIN=/usr/local/bin/codex

# Where Placed keeps its database, uploaded CVs and secret key (default ./data).
# PLACED_DATA_DIR=./data

# Port (default 3000). Next.js reads PORT before it loads this file, so set it in the shell instead:
#   PORT=3001 npm run dev
# The server always listens on 127.0.0.1 only. If you change the port, the Chrome extension won't find the app
# (it expects http://localhost:3000).
# PORT=3000

# Autopilot (application-form filling through the Chrome extension) is on by default. 0 = hide it.
# NEXT_PUBLIC_AUTOPILOT=0

# Inside Track: finds real people (alumni, team, recruiter) at companies you've applied to, via Serper (https://serper.dev).
# Can also be saved in Settings → People search.
# SERPER_API_KEY=
